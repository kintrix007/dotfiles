[Appearance]
AntiAliasFonts=true
BoldIntense=true
BorderWhenActive=false
ColorScheme=Breeze
EmojiFont=Noto Color Emoji,10,-1,5,50,0,0,0,0,0
Font=FiraCode Nerd Font,13,-1,5,50,0,0,0,0,0
IgnoreWcWidth=false
UseFontLineChararacters=true
WordMode=true
WordModeAscii=true
WordModeAttr=false
WordModeBrahmic=false

[General]
InvertSelectionColors=false
Name=default
Parent=FALLBACK/
TerminalCenter=true
TerminalColumns=80
TerminalRows=24

[Interaction Options]
TextEditorCmd=6
TextEditorCmdCustom=nvim +LINE PATH
UnderlineFilesEnabled=true

[Keyboard]
KeyBindings=default

[Scrolling]
ScrollBarPosition=2

[Terminal Features]
BellMode=1
BidiLineLTR=true
BidiRenderingEnabled=true
BidiTableDirOverride=true
